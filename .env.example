# Copia este archivo a .env. No incluyas credenciales reales en el repositorio.
# Usa una cuenta de Atlas con permisos limitados a la base que necesitas.
MONGODB_URI=""
# Mantener separada la base local evita modificar datos de produccion.
MONGODB_DB="kyon_dev"
# Genera un secreto aleatorio y guardalo solo en .env.
SESSION_SECRET=""
VERCEL_ENV="development"
